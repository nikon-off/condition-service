apiVersion: v1
clusters:
- cluster:
    certificate-authority-data: 
    server: https://condition-service-control-plane:6443
  name: condition-service
contexts:
- context:
    cluster: condition-service
    user: kubernetes-admin
  name: kubernetes-admin@condition-service
current-context: kubernetes-admin@condition-service
kind: Config
users:
- name: kubernetes-admin
  user:
    client-certificate-data: 
    client-key-data: 
