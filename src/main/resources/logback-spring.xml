<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Имя приложения из Spring Environment (spring.application.name) -->
    <springProperty scope="context" name="appName"
        source="spring.application.name" defaultValue="condition-service" />

    <!-- Профиль "json": structured (JSON) логирование через LogstashEncoder -->
    <springProfile name="json">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"${appName}"}</customFields>
                <includeMdc>true</includeMdc>
                <includeContext>false</includeContext>
                <timeZone>UTC</timeZone>
                <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE" />
        </root>
    </springProfile>

    <!-- Все остальные профили: человекочитаемый вывод в консоль -->
    <springProfile name="!json">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

</configuration>